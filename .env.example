# Copy to .env and fill in. .env is gitignored, never commit it.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# The TOTP *secret* shown when enabling TOTP on SmartAPI (not a 6-digit code)
ANGEL_TOTP_SECRET=

# Optional: Telegram alerts (create a bot with @BotFather). Leave the token empty to disable.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids that always receive alerts (the bot tells you your id when you message it)
TELEGRAM_CHAT_IDS=
# Optional: others can subscribe by sending "/start <code>" to the bot. Empty = no self-subscription.
TELEGRAM_SUBSCRIBE_CODE=
